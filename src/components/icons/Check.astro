---
interface Props {
	class?: string;
}

const { class: className = 'h-4 w-4 text-emerald-600 shrink-0' } = Astro.props;
---

<svg
	xmlns="http://www.w3.org/2000/svg"
	width="24"
	height="24"
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="2"
	stroke-linecap="round"
	stroke-linejoin="round"
	class:list={['lucide lucide-check', className]}
	aria-hidden="true"
>
	<path d="M20 6 9 17 4 12"></path>
</svg>
