---
import { contacts } from '../data/site';
---

<section id="contact" class="relative py-24 lg:py-32 border-t border-zinc-200">
	<div class="mx-auto max-w-7xl px-5 sm:px-8">
		<div class="grid lg:grid-cols-2 gap-12 lg:gap-20">
			<div>
				<p class="text-sm font-medium uppercase tracking-[0.2em] text-zinc-500 mb-4">Первый шаг</p>
				<h2 class="font-display text-4xl sm:text-5xl font-bold uppercase tracking-tighter text-zinc-900 leading-[0.95]">
					Обсудим вашу задачу
				</h2>
				<p class="mt-6 text-base text-zinc-600 leading-relaxed max-w-lg">
					Расскажите, где в вашем бизнесе больше всего рутины. Мы бесплатно разберём процесс и покажем, что можно автоматизировать в первую очередь.
				</p>

				<div class="mt-10 space-y-4">
					<a
						href={contacts.telegram}
						target="_blank"
						rel="noopener noreferrer"
						class="flex items-center gap-3 text-sm font-medium text-zinc-700 hover:text-zinc-900 transition-colors"
					>
						<span class="grid place-items-center h-10 w-10 rounded-full border border-zinc-200">
							<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
								<path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 0 0-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.74-.55 2.92-1.27 4.86-2.11 5.83-2.51 2.78-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .38z"></path>
							</svg>
						</span>
						Telegram — {contacts.telegramHandle}
					</a>
					<a
						href={`mailto:${contacts.email}`}
						class="flex items-center gap-3 text-sm font-medium text-zinc-700 hover:text-zinc-900 transition-colors"
					>
						<span class="grid place-items-center h-10 w-10 rounded-full border border-zinc-200">
							<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<path d="M4 4h16v16H4z"></path>
								<path d="m22 6-10 7L2 6"></path>
							</svg>
						</span>
						{contacts.email}
					</a>
				</div>
			</div>

			<form id="contact-form" class="border border-zinc-200 bg-white p-6 sm:p-8 space-y-5">
				<div>
					<label for="contact-name" class="block text-sm font-medium text-zinc-700 mb-2">
						Как вас зовут
					</label>
					<input
						id="contact-name"
						name="name"
						type="text"
						required
						class="w-full border border-zinc-200 bg-[#FDFDFC] px-4 py-3 text-sm text-zinc-900 outline-none focus:border-zinc-400 transition-colors"
					/>
				</div>
				<div>
					<label for="contact-phone" class="block text-sm font-medium text-zinc-700 mb-2">
						Телефон или Telegram
					</label>
					<input
						id="contact-phone"
						name="phone"
						type="text"
						required
						class="w-full border border-zinc-200 bg-[#FDFDFC] px-4 py-3 text-sm text-zinc-900 outline-none focus:border-zinc-400 transition-colors"
					/>
				</div>
				<div>
					<label for="contact-task" class="block text-sm font-medium text-zinc-700 mb-2">
						Что хотите автоматизировать
					</label>
					<textarea
						id="contact-task"
						name="task"
						rows="4"
						required
						class="w-full border border-zinc-200 bg-[#FDFDFC] px-4 py-3 text-sm text-zinc-900 outline-none focus:border-zinc-400 transition-colors resize-y min-h-[120px]"
					></textarea>
				</div>
				<button
					type="submit"
					class="w-full sm:w-auto inline-flex items-center justify-center rounded-full bg-emerald-500 hover:bg-emerald-600 px-8 py-3.5 text-sm font-medium text-white transition-colors"
				>
					Отправить заявку
				</button>
				<p id="contact-form-status" class="text-sm text-zinc-500 hidden" role="status"></p>
			</form>
		</div>
	</div>
</section>
