---
import { navLinks } from '../data/site';
---

<header
	data-testid="navbar"
	class="fixed top-0 left-0 right-0 z-50 transition-colors duration-300 bg-[#FDFDFC]/80 backdrop-blur-xl border-b border-zinc-200"
>
	<div class="mx-auto max-w-7xl px-5 sm:px-8">
		<div class="flex h-16 items-center justify-between gap-6">
			<a href="#" class="font-display text-lg font-bold tracking-tight text-zinc-900">
				CreateMind
			</a>

			<nav class="hidden md:flex items-center gap-9" aria-label="Основная навигация">
				{
					navLinks.map((link) => (
						<a
							href={link.href}
							class="text-sm font-medium text-zinc-600 hover:text-zinc-900 transition-colors"
						>
							{link.label}
						</a>
					))
				}
			</nav>

			<div class="flex items-center gap-3">
				<a
					href="#contact"
					class="hidden sm:inline-flex items-center gap-2.5 rounded-full bg-zinc-900 px-5 py-2.5 text-sm font-medium text-white transition-colors hover:bg-zinc-800"
				>
					Обсудить задачу
				</a>

				<button
					type="button"
					id="mobile-menu-btn"
					class="md:hidden grid place-items-center h-10 w-10 rounded-full border border-zinc-200 text-zinc-700"
					aria-expanded="false"
					aria-controls="mobile-menu"
					aria-label="Открыть меню"
				>
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<path d="M4 7h16M4 12h16M4 17h16"></path>
					</svg>
				</button>
			</div>
		</div>
	</div>

	<div id="mobile-menu" class="hidden md:hidden border-t border-zinc-200 bg-[#FDFDFC]">
		<nav class="mx-auto max-w-7xl px-5 py-4 flex flex-col gap-3" aria-label="Мобильная навигация">
			{
				navLinks.map((link) => (
					<a
						href={link.href}
						class="text-sm font-medium text-zinc-700 py-2"
					>
						{link.label}
					</a>
				))
			}
			<a
				href="#contact"
				class="mt-2 inline-flex items-center justify-center rounded-full bg-zinc-900 px-5 py-2.5 text-sm font-medium text-white"
			>
				Обсудить задачу
			</a>
		</nav>
	</div>
</header>
