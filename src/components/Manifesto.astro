---
import { manifestoPrinciples, manifestoStats } from '../data/manifesto';
---

<section id="manifesto" class="relative py-24 lg:py-32 bg-[#0A0A0A] text-white">
	<div class="mx-auto max-w-7xl px-5 sm:px-8">
		<div class="max-w-3xl mb-16 lg:mb-24">
			<p class="text-sm font-medium uppercase tracking-[0.2em] text-zinc-400 mb-4">Наш подход</p>
			<h2 class="font-display text-4xl sm:text-5xl lg:text-6xl font-bold uppercase tracking-tighter leading-[0.95]">
				<span class="block">Автоматизация,</span>
				<span class="block">которая <span class="text-emerald-400">окупается</span></span>
			</h2>
		</div>

		<div class="grid lg:grid-cols-3 gap-8 lg:gap-12 mb-20 lg:mb-28">
			{
				manifestoPrinciples.map((principle) => (
					<div class="border-t border-zinc-800 pt-6">
						<div class="text-sm font-medium text-emerald-400 mb-4">{principle.number}</div>
						<h3 class="font-display text-xl font-bold uppercase tracking-tight mb-4">
							{principle.title}
						</h3>
						<p class="text-sm text-zinc-400 leading-relaxed">
							{principle.description}
						</p>
					</div>
				))
			}
		</div>

		<div class="grid grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-12 border-t border-zinc-800 pt-10">
			{
				manifestoStats.map((stat) => (
					<div>
						<div class="font-display text-3xl sm:text-4xl font-bold text-white">{stat.value}</div>
						<div class="mt-2 text-sm text-zinc-400 leading-relaxed">{stat.label}</div>
					</div>
				))
			}
		</div>
	</div>
</section>
