---
import { useCases } from '../data/useCases';
import Check from './icons/Check.astro';
---

<section id="use-cases" class="relative py-24 lg:py-32 border-t border-zinc-200">
	<div class="max-w-7xl mx-auto px-6 lg:px-8">
		<div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6 mb-16">
			<h2
				class="font-display font-bold uppercase tracking-tighter leading-[0.95] text-4xl md:text-5xl lg:text-6xl text-zinc-900"
			>
				<span class="block overflow-hidden">
					<span class="block">Узнайте</span>
				</span>
				<span class="block overflow-hidden">
					<span class="block">свой бизнес</span>
				</span>
			</h2>
			<div class="max-w-md">
				<p class="text-lg text-zinc-600 leading-relaxed">
					Если в вашей компании есть хотя бы одно из этого — мы знаем, как это автоматизировать.
				</p>
			</div>
		</div>

		<div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-px bg-zinc-200 border border-zinc-200">
			{
				useCases.map((item) => (
					<article
						data-testid={`usecase-${item.id}`}
						class="group relative bg-white p-8 lg:p-9 flex flex-col hover:bg-zinc-50 transition-colors duration-300"
					>
						<div class="relative h-40 mb-7 overflow-hidden border border-zinc-200">
							<img
								src={item.image}
								alt={item.imageAlt}
								class="w-full h-full object-cover grayscale group-hover:grayscale-0 scale-105 group-hover:scale-100 transition-all duration-700"
								loading="lazy"
							/>
						</div>
						<h3 class="font-display text-lg font-bold uppercase tracking-tight text-zinc-900">
							{item.title}
						</h3>
						<p class="mt-3 text-sm text-zinc-500 leading-relaxed flex-1">
							{item.description}
						</p>
						<div
							class="mt-7 flex w-full min-h-[52px] items-center gap-2.5 rounded-lg bg-emerald-50 border border-emerald-200 px-3.5 py-2.5"
						>
							<Check />
							<span class="text-sm font-semibold text-emerald-700 leading-tight">
								{item.badge}
							</span>
						</div>
					</article>
				))
			}
		</div>
	</div>
</section>
