---
import { useCases } from '../data/useCases';
---

<section id="use-cases" class="relative py-24 lg:py-32">
	<div class="mx-auto max-w-7xl px-5 sm:px-8">
		<div class="max-w-3xl mb-16 lg:mb-20">
			<h2 class="font-display text-4xl sm:text-5xl lg:text-6xl font-bold uppercase tracking-tighter text-zinc-900 leading-[0.95]">
				<span class="block">Узнайте</span>
				<span class="block text-emerald-500">свой бизнес</span>
			</h2>
			<p class="mt-6 text-base sm:text-lg text-zinc-600 leading-relaxed max-w-2xl">
				Если в вашей компании есть хотя бы одно из этого — мы знаем, как это автоматизировать.
			</p>
		</div>

		<div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
			{
				useCases.map((item) => (
					<article
						data-testid={`usecase-${item.id}`}
						class="group border border-zinc-200 bg-white p-6 sm:p-7 transition-colors hover:border-zinc-300"
					>
						<div class="relative h-40 mb-7 overflow-hidden border border-zinc-200 bg-zinc-100">
							<img
								src={item.image}
								alt={item.imageAlt}
								class="w-full h-full object-cover grayscale group-hover:grayscale-0 scale-105 group-hover:scale-100 transition-all duration-700"
								loading="lazy"
							/>
						</div>
						<h3 class="font-display text-lg font-bold uppercase tracking-tight text-zinc-900">
							{item.title}
						</h3>
						<p class="mt-3 text-sm text-zinc-500 leading-relaxed">
							{item.description}
						</p>
						<p class="mt-5 inline-flex items-center text-xs font-medium uppercase tracking-wide text-emerald-600 border border-emerald-200 bg-emerald-50 px-3 py-1.5">
							{item.badge}
						</p>
					</article>
				))
			}
		</div>
	</div>
</section>
