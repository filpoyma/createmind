<div class="modal-overlay" id="modal-overlay">
	<div class="modal">
		<button class="modal-close" type="button" aria-label="Закрыть">×</button>
		<div id="modal-content">
			<h3 data-translate data-ru="Обсудим вашу задачу" data-en="Let's discuss your project">
				Обсудим вашу задачу
			</h3>
			<p
				data-translate
				data-ru="Оставьте контакт и коротко опишите процесс, который хотите автоматизировать. Мы ответим в течение нескольких часов."
				data-en="Leave your contact and briefly describe the process you want to automate. We'll reply within a few hours."
			>
				Оставьте контакт и коротко опишите процесс, который хотите автоматизировать. Мы
				ответим в течение нескольких часов.
			</p>
			<form>
				<div class="form-group">
					<label data-translate data-ru="Имя" data-en="Name">Имя</label>
					<input
						type="text"
						placeholder="Как вас зовут?"
						data-translate-placeholder
						data-placeholder-ru="Как вас зовут?"
						data-placeholder-en="Your name"
						required
					/>
				</div>
				<div class="form-group">
					<label data-translate data-ru="Telegram или телефон" data-en="Telegram or phone">
						Telegram или телефон
					</label>
					<input
						type="text"
						placeholder="@username или +7..."
						data-translate-placeholder
						data-placeholder-ru="@username или +7..."
						data-placeholder-en="@username or +1..."
						required
					/>
				</div>
				<div class="form-group">
					<label
						data-translate
						data-ru="Что хотите автоматизировать?"
						data-en="What do you want to automate?"
					>
						Что хотите автоматизировать?
					</label>
					<textarea
						placeholder="Например: у нас строительная компания, хотим убрать ручную запись заявок и отправку КП..."
						data-translate-placeholder
						data-placeholder-ru="Например: у нас строительная компания, хотим убрать ручную запись заявок и отправку КП..."
						data-placeholder-en="E.g.: we're a construction company and want to automate lead intake and proposals..."
					></textarea>
				</div>
				<button type="submit" class="form-submit" data-translate data-ru="Отправить →" data-en="Send →">
					Отправить →
				</button>
			</form>
		</div>
	</div>
</div>
