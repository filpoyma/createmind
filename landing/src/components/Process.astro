---
import { processSteps } from '../data/process';
---

<section id="process" class="relative py-24 lg:py-32 border-t border-zinc-200">
	<div class="max-w-7xl mx-auto px-6 lg:px-8">
		<div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6 mb-16">
			<h2
				class="font-display font-bold uppercase tracking-tighter leading-[0.95] text-4xl md:text-5xl lg:text-6xl text-zinc-900"
			>
				<span class="block overflow-hidden">
					<span class="block">Как мы</span>
				</span>
				<span class="block overflow-hidden">
					<span class="block">работаем</span>
				</span>
			</h2>
			<div class="max-w-md">
				<p class="text-lg text-zinc-600 leading-relaxed">
					Прозрачный путь от первого разговора до работающей системы. Вы видите результат на каждом шаге.
				</p>
			</div>
		</div>

		<div class="grid md:grid-cols-2 lg:grid-cols-4 gap-px bg-zinc-200 border border-zinc-200">
			{
				processSteps.map((step) => (
					<div
						class="group bg-white p-8 lg:p-9 flex flex-col min-h-[280px] hover:bg-zinc-900 transition-colors duration-500"
						data-testid={`process-${step.number}`}
					>
						<span
							class="font-display text-5xl font-light text-zinc-300 group-hover:text-emerald-400 transition-colors duration-500"
						>
							{step.number}
						</span>
						<div class="mt-auto">
							<h3
								class="font-display text-xl font-semibold tracking-tight text-zinc-900 group-hover:text-white transition-colors duration-500"
							>
								{step.title}
							</h3>
							<p
								class="mt-3 text-[15px] leading-relaxed text-zinc-600 group-hover:text-zinc-400 transition-colors duration-500"
							>
								{step.description}
							</p>
						</div>
					</div>
				))
			}
		</div>
	</div>
</section>
