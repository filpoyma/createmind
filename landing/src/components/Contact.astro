---
import { contacts } from '../data/site';
import ArrowUpRight from './icons/ArrowUpRight.astro';
---

<section id="contact" class="relative py-24 lg:py-32 border-t border-zinc-200">
	<div class="max-w-7xl mx-auto px-6 lg:px-8">
		<div class="grid lg:grid-cols-12 gap-12 lg:gap-16">
			<div class="lg:col-span-5">
				<span class="font-display text-[11px] uppercase tracking-[0.22em] text-emerald-600">
					Первый шаг
				</span>
				<h2
					class="mt-6 font-display font-bold uppercase tracking-tighter leading-[0.95] text-4xl md:text-5xl lg:text-6xl text-zinc-900"
				>
					<span class="block overflow-hidden">
						<span class="block">Обсудим</span>
					</span>
					<span class="block overflow-hidden">
						<span class="block">вашу задачу</span>
					</span>
				</h2>
				<p class="mt-8 text-lg text-zinc-600 leading-relaxed max-w-md">
					Расскажите, где в вашем бизнесе больше всего рутины. Мы бесплатно разберём процесс и покажем, что можно автоматизировать в первую очередь.
				</p>
				<div class="mt-10 flex flex-col gap-3 text-zinc-900">
					<a
						href={contacts.telegram}
						data-testid="contact-telegram"
						class="group inline-flex items-center gap-2 font-semibold hover:text-emerald-600 transition-colors"
					>
						Telegram — {contacts.telegramHandle}
						<ArrowUpRight />
					</a>
					<a
						href={`mailto:${contacts.email}`}
						data-testid="contact-email"
						class="group inline-flex items-center gap-2 font-semibold hover:text-emerald-600 transition-colors"
					>
						{contacts.email}
						<ArrowUpRight />
					</a>
				</div>
			</div>

			<div class="lg:col-span-7">
				<form
					id="contact-form"
					data-testid="contact-form"
					class="border border-zinc-200 bg-white p-8 lg:p-12"
				>
					<div class="space-y-8">
						<div>
							<label class="text-xs uppercase tracking-[0.2em] text-zinc-500 font-bold">
								Как вас зовут
							</label>
							<input
								id="contact-name"
								name="name"
								type="text"
								data-testid="contact-name"
								placeholder="Иван Петров"
								required
								class="mt-3 w-full bg-transparent border-b border-zinc-300 pb-3 text-lg text-zinc-900 placeholder:text-zinc-400 outline-none focus:border-zinc-900 transition-colors"
							/>
						</div>
						<div>
							<label class="text-xs uppercase tracking-[0.2em] text-zinc-500 font-bold">
								Телефон или Telegram
							</label>
							<input
								id="contact-input"
								name="phone"
								type="text"
								data-testid="contact-input"
								placeholder="+7 900 000-00-00 / @username"
								required
								class="mt-3 w-full bg-transparent border-b border-zinc-300 pb-3 text-lg text-zinc-900 placeholder:text-zinc-400 outline-none focus:border-zinc-900 transition-colors"
							/>
						</div>
						<div>
							<label class="text-xs uppercase tracking-[0.2em] text-zinc-500 font-bold">
								Что хотите автоматизировать
							</label>
							<textarea
								id="contact-task"
								name="task"
								data-testid="contact-task"
								rows="3"
								placeholder="Например: менеджеры вручную отвечают клиентам в WhatsApp..."
								required
								class="mt-3 w-full bg-transparent border-b border-zinc-300 pb-3 text-lg text-zinc-900 placeholder:text-zinc-400 outline-none focus:border-zinc-900 transition-colors resize-none"
							></textarea>
						</div>
					</div>
					<button
						type="submit"
						data-testid="contact-submit"
						class="group mt-10 relative inline-flex items-center gap-2 rounded-full bg-zinc-900 px-8 py-4 text-base font-semibold text-white overflow-hidden"
					>
						<span class="relative z-10">Отправить заявку</span>
						<ArrowUpRight hoverAnimation="rotate" class="relative z-10 h-5 w-5" />
						<span
							class="absolute inset-0 bg-emerald-500 translate-y-full group-hover:translate-y-0 transition-transform duration-300"
						></span>
					</button>
					<p id="contact-form-status" class="mt-4 text-sm text-emerald-600 hidden" role="status"></p>
				</form>
			</div>
		</div>
	</div>
</section>
