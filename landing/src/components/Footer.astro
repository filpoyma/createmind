---
import { contacts } from '../data/site';
import ArrowUpRight from './icons/ArrowUpRight.astro';
import { useTranslations, getLocaleFromAstro } from '../i18n';

const locale = getLocaleFromAstro(Astro.currentLocale);
const t = useTranslations(locale);
---

<footer data-testid="footer" class="relative bg-[#0A0A0A] text-white pt-20 pb-10 overflow-hidden">
	<div class="max-w-7xl mx-auto px-6 lg:px-8">
		<div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-10 pb-16 border-b border-zinc-800">
			<div>
				<div class="flex items-center gap-2.5 mb-6">
					<span class="h-2.5 w-2.5 rounded-full bg-emerald-500"></span>
					<span class="font-display font-bold text-lg tracking-tighter">CreateMind</span>
				</div>
				<p class="max-w-sm text-zinc-400 leading-relaxed">
					{t('footer.description')}
				</p>
			</div>
			<div class="flex flex-col gap-3">
				<a
					href={contacts.telegram}
					class="group inline-flex items-center gap-2 text-zinc-300 hover:text-emerald-400 transition-colors"
				>
					Telegram
					<ArrowUpRight />
				</a>
				<a
					href={contacts.whatsapp}
					class="group inline-flex items-center gap-2 text-zinc-300 hover:text-emerald-400 transition-colors"
				>
					WhatsApp
					<ArrowUpRight />
				</a>
				<a
					href={`mailto:${contacts.email}`}
					class="group inline-flex items-center gap-2 text-zinc-300 hover:text-emerald-400 transition-colors"
				>
					{contacts.email}
					<ArrowUpRight />
				</a>
			</div>
		</div>

		<button
			type="button"
			id="footer-logo"
			data-testid="footer-logo"
			class="block w-full mt-14 text-left"
			aria-label={t('footer.scrollTop')}
		>
			<span
				class="font-display font-bold uppercase tracking-tighter leading-none text-[15.5vw] text-white hover:text-emerald-400 transition-colors duration-500 block"
			>
				CreateMind
			</span>
		</button>

		<div class="mt-10 flex flex-col sm:flex-row justify-between gap-4 text-sm text-zinc-500">
			<span>{t('footer.copyright')}</span>
			<span>
				{t('footer.tagline')} ·
				<span class="text-zinc-600">{t('footer.privacy')}</span>
			</span>
		</div>
	</div>
</footer>
