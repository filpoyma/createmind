---
import { marqueeItems } from '../data/site';

const items = [...marqueeItems, ...marqueeItems];
---

<div
	data-testid="marquee"
	class="border-y border-zinc-200 bg-white py-4 overflow-hidden"
>
	<div class="flex animate-marquee whitespace-nowrap">
		{
			items.map((item, i) => (
				<span
					class="inline-flex items-center gap-8 px-8 font-display text-sm sm:text-base font-semibold uppercase tracking-[0.2em] text-zinc-400"
					aria-hidden={i >= marqueeItems.length ? 'true' : undefined}
				>
					{item}
					<span class="text-emerald-500">•</span>
				</span>
			))
		}
	</div>
</div>
