---
import { manifestoPrinciples, manifestoStats } from '../data/manifesto';
---

<section id="manifesto" class="relative py-24 lg:py-32 bg-[#0A0A0A] text-white">
	<div class="max-w-7xl mx-auto px-6 lg:px-8">
		<div class="mb-20">
			<span class="font-display text-[11px] uppercase tracking-[0.22em] text-emerald-400">
				Наш подход
			</span>
			<h2
				class="mt-6 font-display font-bold uppercase tracking-tighter leading-[0.95] text-4xl md:text-5xl lg:text-6xl max-w-4xl"
			>
				<span class="block overflow-hidden">
					<span class="block">Автоматизация,</span>
				</span>
				<span class="block overflow-hidden">
					<span class="block">
						которая <span class="text-emerald-400">окупается</span>
					</span>
				</span>
			</h2>
		</div>

		<div class="divide-y divide-zinc-800 border-t border-zinc-800">
			{
				manifestoPrinciples.map((principle) => (
					<div
						class="grid md:grid-cols-12 gap-6 md:gap-8 py-12 group"
						data-testid={`manifesto-${principle.number}`}
					>
						<div class="md:col-span-3">
							<span
								class="font-display text-6xl md:text-7xl font-light text-zinc-700 group-hover:text-emerald-400 transition-colors duration-500"
							>
								{principle.number}
							</span>
						</div>
						<h3
							class="md:col-span-4 font-display text-2xl md:text-3xl font-semibold tracking-tight leading-snug"
						>
							{principle.title}
						</h3>
						<p class="md:col-span-5 text-lg leading-relaxed text-zinc-400">
							{principle.description}
						</p>
					</div>
				))
			}
		</div>

		<div class="mt-24 grid grid-cols-2 lg:grid-cols-4 gap-px bg-zinc-800 border border-zinc-800">
			{
				manifestoStats.map((stat, index) => (
					<div class="bg-[#0A0A0A] p-8" data-testid={`stat-${index}`}>
						<div class="font-display text-4xl md:text-5xl font-bold tracking-tighter text-emerald-400">
							{stat.value}
						</div>
						<div class="mt-3 text-sm text-zinc-500 leading-snug">
							{stat.label}
						</div>
					</div>
				))
			}
		</div>
	</div>
</section>
