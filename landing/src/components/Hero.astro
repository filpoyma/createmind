---
---

<section id="hero" class="hero-section relative pt-24 pb-16 lg:pt-28 lg:pb-24 overflow-hidden">
	<div class="mx-auto max-w-7xl px-8">
		<div id="hero-inner" class="hero-inner relative">
			<div id="hero-backdrop" class="hero-backdrop">
				<div class="flex flex-col items-center gap-8 lg:grid lg:grid-cols-2 lg:items-stretch lg:gap-x-10 xl:gap-x-14">
					<div class="min-w-0 w-full max-w-xl lg:max-w-none">
						<div class="inline-flex items-center gap-2 rounded-full border border-zinc-200 bg-white px-4 py-1.5 text-xs font-medium uppercase tracking-wider text-zinc-600 mb-8">
							<span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
							AI-автоматизация для бизнеса
						</div>

						<h1
							class="font-display font-bold uppercase tracking-tighter leading-[0.94] text-[12vw] sm:text-6xl lg:text-[4.3vw] text-zinc-900"
						>
							<span class="block">AI-автоматизация</span>
							<span class="block">для <span class="text-emerald-500">бизнеса</span></span>
						</h1>

						<p
							class="mt-6 font-display font-bold uppercase tracking-tighter leading-[0.94] text-2xl sm:text-3xl lg:text-[2vw] text-zinc-500"
						>
							Ваш бизнес работает на <span class="text-emerald-500">ручном труде.</span> Пора это изменить.
						</p>

						<p class="mt-8 max-w-xl text-base sm:text-lg text-zinc-600 leading-relaxed">
							Внедряем искусственный интеллект в реальные процессы компаний — от ответов клиентам до бухгалтерии и склада. Без переписывания всего с нуля.
						</p>
					</div>

					<div class="sphere-wrapper-col mx-auto lg:mx-0 lg:justify-self-end w-full max-w-[300px] lg:h-full">
						<div class="sphere-stage">
							<div id="sphere-trigger" aria-label="AI-помощник CreateMind">
								<div class="robot-speech-bubble" id="robot-bubble">
									<span id="bubble-text">Какая у вас задача для меня?</span>
								</div>
								<canvas id="crystal-canvas"></canvas>
								<div id="sphere-glow-ring"></div>
							</div>
						</div>
						<div class="hero-stat-card mt-4 lg:mt-0 rounded-2xl border border-zinc-200 bg-white p-5 sm:p-6 w-full">
							<div class="font-display text-3xl sm:text-4xl font-bold text-zinc-900">24/7</div>
							<p class="mt-2 text-sm text-zinc-600 leading-relaxed">
								процессы идут без выходных, обедов и человеческого фактора
							</p>
						</div>
					</div>
				</div>
			</div>

			<div
				id="hero-chat-shell"
				class="hero-chat-shell mt-10 mx-auto lg:mx-0 max-w-xl w-full"
			>
				<div id="hero-chat-titlebar" class="hero-chat-titlebar" hidden>
					<button
						type="button"
						id="hero-chat-minimize"
						class="hero-chat-minimize"
						aria-label="Свернуть чат"
					>
						<span class="hero-chat-traffic-light" aria-hidden="true"></span>
					</button>
					<button
						type="button"
						id="hero-chat-download"
						class="hero-chat-download-btn"
						hidden
					>
						Скачать ТЗ
					</button>
				</div>

				<div
					id="hero-chat-messages"
					class="hero-chat-messages"
					role="log"
					aria-live="polite"
					aria-relevant="additions"
					hidden
				></div>

				<div class="hero-chat-composer">
					<div
						id="hero-input-bar"
						class="hero-input-bar flex items-center gap-3 rounded-full border border-zinc-200 bg-white p-2 pl-4 w-full shadow-sm"
					>
						<button
							type="button"
							id="hero-mic-btn"
							class="hero-mic-btn grid place-items-center h-10 w-10 rounded-full text-zinc-500 hover:text-zinc-900 hover:bg-zinc-100 transition-colors disabled:opacity-50 disabled:pointer-events-none"
							aria-label="Голосовой ввод"
							aria-pressed="false"
							aria-busy="false"
						>
							<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<path d="M12 19v3"></path>
								<path d="M19 10v2a7 7 0 0 1-14 0v-2"></path>
								<rect x="9" y="2" width="6" height="13" rx="3"></rect>
							</svg>
						</button>
						<input
							data-testid="hero-task-input"
							id="hero-input"
							type="text"
							placeholder="Опишите вашу задачу..."
							class="flex-1 bg-transparent outline-none text-zinc-900 placeholder:text-zinc-400 text-base min-w-0"
						/>
						<button
							data-testid="hero-submit"
							id="hero-submit"
							type="button"
							class="group grid place-items-center h-11 w-11 rounded-full bg-emerald-500 hover:bg-emerald-600 text-white transition-colors shrink-0"
							aria-label="Отправить"
						>
							<svg
								width="18"
								height="18"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								class="transition-transform group-hover:translate-x-0.5"
							>
								<path d="M5 12h14"></path>
								<path d="m12 5 7 7-7 7"></path>
							</svg>
						</button>
					</div>
					<p
						id="hero-voice-status"
						class="hidden mt-2 w-full text-sm text-zinc-500"
						role="status"
						aria-live="polite"
					></p>
				</div>
			</div>
		</div>
	</div>
</section>

<style is:global>
	@import '../styles/hero-sphere.css';
</style>

<script src="../scripts/hero.ts"></script>
