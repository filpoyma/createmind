---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import UseCases from '../components/UseCases.astro';
import Manifesto from '../components/Manifesto.astro';
import Process from '../components/Process.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import { useCases } from '../data/useCases';
import { SITE_URL } from '../lib/seo';

const useCasesJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'ItemList',
	name: 'Кейсы AI-автоматизации для бизнеса',
	itemListElement: useCases.map((item, index) => ({
		'@type': 'ListItem',
		position: index + 1,
		name: item.title,
		description: item.description,
		url: `${SITE_URL}/#use-cases`,
	})),
};
---

<BaseLayout>
	<script type="application/ld+json" set:html={JSON.stringify(useCasesJsonLd)} />
	<Header />
	<main>
		<Hero />
		<Marquee />
		<UseCases />
		<Manifesto />
		<Process />
		<Contact />
	</main>
	<Footer />
</BaseLayout>
