# Development. Production (NODE_ENV=production) uses DB_USER, DB_PASSWORD, DB_AUTH_SOURSE.
MONGODB_URI=mongodb://localhost:27017/createmind
DB_USER=
DB_PASSWORD=
DB_AUTH_SOURSE=admin

GROQ_API_KEY=your_groq_api_key

OPENROUTER_API_KEY=your_openrouter_api_key
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_HTTP_REFERER=https://createmind.org
# OPENROUTER_APP_NAME=CreateMind

# Resend — отправка ТЗ на request@createmind.org после завершения заявки
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM=CreateMind <onboarding@resend.dev>
RESEND_SPEC_TO=request@createmind.org

# Telegram — уведомления в чат/группу (ТЗ и заявки с формы на сайте)
TELEGRAM_BOT_TOKEN=123456789:AAFxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=147917436

# Comma-separated origins for CORS in development (Astro default: http://localhost:4321)
CORS_ORIGIN_DEV=http://localhost:4321
CORS_ORIGIN_PROD=
